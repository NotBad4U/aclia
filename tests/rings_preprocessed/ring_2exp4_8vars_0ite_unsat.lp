    set H0l' ≔ (1 * ((— (s_0 + o_0 + s_1 + s_2 + o_1 + s_3 + s_4 + o_2 + s_5 + s_6 + o_3 + o_4 + o_5 + o_6 + ((— 64) * s_7) + ((— 64) * o_7) + ((— 32) * s_8) + ((— 32) * o_8) + ((— 16) * s_9) + ((— 16) * o_9) + ((— 8) * s_10) + ((— 8) * o_10) + ((— 4) * s_11) + ((— 4) * o_11) + ((— 2) * s_12) + ((— 2) * o_12) + ((— 1) * s_13) + ((— 1) * o_13))) - (— 0)));
    set H0r' ≔ (1 * (0 + 1));
    set H1l' ≔ (1 * ((s_0 + o_0 + s_1 + s_2 + o_1 + s_3 + s_4 + o_2 + s_5 + s_6 + o_3 + o_4 + o_5 + o_6 + ((— 64) * s_7) + ((— 64) * o_7) + ((— 32) * s_8) + ((— 32) * o_8) + ((— 16) * s_9) + ((— 16) * o_9) + ((— 8) * s_10) + ((— 8) * o_10) + ((— 4) * s_11) + ((— 4) * o_11) + ((— 2) * s_12) + ((— 2) * o_12) + ((— 1) * s_13) + ((— 1) * o_13)) - (— 1)));
    set H1r' ≔ (1 * (0 + 1));
    have contra : πᶜ ((denote (reify (H0l' + H1l'))) ≥ (denote (reify (H0r' + H1r')))) {
        rewrite inj;
        rewrite inj;
        apply (Zsum_geq_s H0l' H0r' H1l' H1r' H0 H1);
    };
    apply (⇒ᶜₑ' contra);
    apply trivial;
};
simplify;
rewrite or_identity_r;
apply (π̇ₗ Hla);
end;
